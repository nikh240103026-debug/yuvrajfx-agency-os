# Copy this file to .env and configure PostgreSQL before starting the app.

# Where the server listens. 127.0.0.1 keeps the app on this computer only.
# Use 0.0.0.0 only behind HTTPS (see README, "Client portal").
HOST=127.0.0.1
PORT=4747

# Required PostgreSQL connection string (managed PostgreSQL recommended).
# Example: postgresql://user:password@host:5432/yuvrajfx?sslmode=require
DATABASE_URL=

# Set to true when the app is served over HTTPS, so session cookies get the Secure flag.
COOKIE_SECURE=false

# Outgoing email (optional). Leave SMTP_HOST empty to keep email off: drafted messages then wait in
# Automations > Outbox, where you can copy them or open them in your own mail app.
# Nothing is ever sent without you pressing "Approve & send" on that message.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="YuvrajFX <billing@example.com>"
